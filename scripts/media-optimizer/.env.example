# Copy to a root-readable environment file on the server; replace every placeholder.
NEXTCLOUD_URL=https://nextcloud.example.invalid
NEXTCLOUD_USERNAME=your-nextcloud-user
NEXTCLOUD_APP_PASSWORD=replace-with-a-nextcloud-app-password

# Host path to the Nextcloud data volume directory containing <username>/files/.
# This is NOT the container path /data. Resolve it on the server before deployment.
NEXTCLOUD_DATA_DIR=/replace/with/host/volume/path
NEXTCLOUD_CONTAINER=replace-with-live-nextcloud-container-name
NEXTCLOUD_OCC_PATH=/config/www/nextcloud/occ
NEXTCLOUD_EXEC_USER=abc

QUEUE_DB=/var/lib/media-optimizer/queue.sqlite
STABLE_FOR=3m
OPT_TAG=opt
SKIP_TAG=skip
JPEGTRAN=/usr/local/mozjpeg/bin/jpegtran
OXIPNG=/usr/local/bin/oxipng
WEBPMUX=/usr/bin/webpmux
FFMPEG=/usr/bin/ffmpeg
FFPROBE=/usr/bin/ffprobe
DOCKER=/usr/bin/docker
