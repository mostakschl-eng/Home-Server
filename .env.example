# Home server credential inventory. Copy this file to .env and fill in values.
# This file is a template, not a deployed service config.
# Never commit .env or paste its contents into chat, logs, or screenshots.

# Host access
SERVER_SSH_HOST=
SERVER_SSH_USERNAME=
SERVER_SSH_PASSWORD=

# Coolify dashboard, database, and Redis
COOLIFY_ADMIN_EMAIL=
COOLIFY_ADMIN_PASSWORD=
COOLIFY_DB_USERNAME=
COOLIFY_DB_PASSWORD=
COOLIFY_REDIS_PASSWORD=

# Nextcloud login and database
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_DB_USERNAME=
NEXTCLOUD_DB_PASSWORD=

# Aria2 RPC
ARIA2_RPC_SECRET=
